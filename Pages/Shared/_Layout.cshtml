<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AHoLa Hotel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyRazorApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AHoLa Hotel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-page="/Index">📊 Tổng quan</a>
                        </li>
                        
                        <!-- 1. Quản lý hệ thống -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                1. Hệ thống
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/System/Accounts">Tài khoản</a></li>
                                <li><a class="dropdown-item" asp-page="/System/Employees">Nhân viên</a></li>
                                <li><a class="dropdown-item" asp-page="/System/Permissions">Phân quyền</a></li>
                            </ul>
                        </li>

                        <!-- 2. Quản lý phòng -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                2. Phòng
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Rooms/TypesAndPricing">Loại phòng & bảng giá</a></li>
                                <li><a class="dropdown-item" asp-page="/Rooms/Diagram">Sơ đồ phòng</a></li>
                            </ul>
                        </li>

                        <!-- 3. Khách hàng & Đặt phòng -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                3. Đặt phòng
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Bookings/Customers">Khách hàng</a></li>
                                <li><a class="dropdown-item" asp-page="/Bookings/Index">Danh sách đặt phòng</a></li>
                            </ul>
                        </li>

                        <!-- 4. Lưu trú & Dịch vụ -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                4. Lưu trú & Dịch vụ
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Stays/CheckIn">Nhận phòng</a></li>
                                <li><a class="dropdown-item" asp-page="/Stays/ActiveStays">Khách đang lưu trú</a></li>
                                <li><a class="dropdown-item" asp-page="/Services/Catalog">Danh mục dịch vụ</a></li>
                                <li><a class="dropdown-item" asp-page="/Services/Record">Ghi nhận dịch vụ</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Privacy">Chính sách</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyRazorApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
