@page
@model MyRazorApp.Pages.Employees.EmployeesModel
@{
    ViewData["Title"] = "Quản lý Nhân viên - AHoLa Hotel";
}

<div class="employees-container container-fluid py-4 px-4">

    <!-- TIÊU ĐỀ TRANG & NÚT THAO TÁC -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-info me-2"></i>Quản Lý Nhân Viên
            </h2>
            <p class="text-muted mb-0">Quản lý danh sách nhân sự, phân công phòng ban và thông tin liên hệ trong hệ thống AHoLa Hotel.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </button>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
                <i class="bi bi-plus-circle me-1"></i> Thêm Nhân Viên
            </button>
        </div>
    </div>

    <!-- 2. THỐNG KÊ NHANH NHÂN SỰ -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 card-stat">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Tổng Nhân Viên</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">24</h3>
                    </div>
                    <div class="icon-box bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 card-stat">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Đang Làm Việc</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">21</h3>
                    </div>
                    <div class="icon-box bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 card-stat">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Đang Nghỉ Phép</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">3</h3>
                    </div>
                    <div class="icon-box bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-person-exclamation fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 card-stat">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Bộ Phận Nhiều Nhất</span>
                        <h3 class="fw-bold text-info mb-0 mt-1">Buồng phòng (8)</h3>
                    </div>
                    <div class="icon-box bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. BỘ LỌC & TÌM KIẾM -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-field form-control border-start-0" placeholder="Tìm kiếm theo mã, tên, email, SĐT...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-field form-select">
                        <option value="">-- Tất cả bộ phận --</option>
                        <option value="1">Lễ tân</option>
                        <option value="2">Buồng phòng</option>
                        <option value="3">F&B (Ẩm thực)</option>
                        <option value="4">Kỹ thuật & Bảo trì</option>
                        <option value="5">Quản lý & Hành chính</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-field form-select">
                        <option value="">-- Trạng thái làm việc --</option>
                        <option value="active">Đang làm việc</option>
                        <option value="leave">Đang nghỉ phép</option>
                        <option value="inactive">Đã nghỉ việc</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. BẢNG DANH SÁCH NHÂN VIÊN (ĐỔ DỮ LIỆU TỪ C# MODEL) -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-employee-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Mã NV</th>
                            <th class="py-3">Họ & Tên</th>
                            <th class="py-3">Bộ Phận / Chức Vụ</th>
                            <th class="py-3">Liên Hệ</th>
                            <th class="py-3">Ngày Vào Làm</th>
                            <th class="py-3">Trạng Thái</th>
                            <th class="pe-4 py-3 text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.EmployeesList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@emp.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@emp.AvatarUrl" class="employee-avatar rounded-circle me-3" alt="Avatar">
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@emp.FullName</h6>
                                            <small class="text-muted">@emp.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@emp.Department</span>
                                    <div class="small text-muted mt-1">@emp.Position</div>
                                </td>
                                <td>
                                    <div class="small fw-medium"><i class="bi bi-telephone text-muted me-1"></i>@emp.Phone</div>
                                    <div class="small text-muted"><i class="bi bi-telephone-inbound text-muted me-1"></i>Ext: @emp.Ext</div>
                                </td>
                                <td class="small text-muted">@emp.JoinDate</td>
                                <td>
                                    @if (emp.Status == "Đang làm việc")
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-dot"></i> @emp.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">
                                            <i class="bi bi-clock-history"></i> @emp.Status
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-light text-primary me-1" title="Chi tiết/Sửa"><i class="bi bi-pencil-square"></i></button>
                                    <button class="btn btn-sm btn-light text-danger" title="Xóa nhân viên"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PHÂN TRANG -->
        <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Hiển thị 1 - 4 trong tổng số 24 nhân viên</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Sau</a></li>
            </ul>
        </div>
    </div>

</div>

<!-- MODAL THÊM NHÂN VIÊN -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus text-primary me-2"></i>Thêm Nhân Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Họ và tên</label>
                        <input type="text" class="form-control" placeholder="Nhập họ và tên...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Mã nhân viên</label>
                        <input type="text" class="form-control" value="NV-1005" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Email</label>
                        <input type="email" class="form-control" placeholder="example@aholahotel.vn">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Số điện thoại</label>
                        <input type="text" class="form-control" placeholder="09xx xxx xxx">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Bộ phận</label>
                        <select class="form-select">
                            <option>Lễ tân</option>
                            <option>Buồng phòng</option>
                            <option>F&B (Ẩm thực)</option>
                            <option>Kỹ thuật</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Chức vụ</label>
                        <input type="text" class="form-control" placeholder="VD: Nhân viên lễ tân">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4">Lưu Nhân Viên</button>
            </div>
        </div>
    </div>
</div>